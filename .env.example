# Copy to .env (gitignored) next to docker-compose.yml, then `docker compose up -d`.
# Every setting has a default: the file needs only the lines that you want to change.
# Full guide: docs/docker.md (the services are named kb and kb-mcp; the CLI inside is a2kb)
#
# [init] marks settings that are read only when the first `up` creates the a2kb config
# (kb-home volume). After that the stored config wins and a changed line here is not
# applied (KB_RECONFIGURE applies the LLM and language lines); see docs/docker.md,
# "Changing settings after the first start". Everything else is applied at every
# `docker compose up -d` (build options need `up -d --build`).

# ── Your knowledge bases ────────────────────────────────────────────
# Names (a-z, 0-9, '-'), separated by commas or spaces. One KB = one Obsidian vault, one
# MCP server, one set of cron jobs. Adding a name later creates that KB; removing one
# deletes nothing. Default: research
KB_NAMES=research

# ── LLM that compiles raw sources into wiki pages [init] ────────────
# claude | codex      reuse a Claude Code / Codex login (no API key): after `up`, run
#                     docker compose exec kb claude auth login
#                     (codex: docker compose exec kb codex login --device-auth)
# gemini | groq | openrouter   API providers: also set KB_LLM_API_KEY
# ollama              local and private: Ollama on the Docker host (KB_LLM_OLLAMA_HOST)
# Cloud providers receive the content you compile; see docs/privacy.md.
KB_LLM=claude
# KB_LLM_MODEL=
# KB_LLM_API_KEY=
# KB_LLM_OLLAMA_HOST=http://host.docker.internal:11434

# [init] Language of wiki pages and answers: en, zh-HK, zh-TW, zh-CN, ja, ... Default: en
KB_LANGUAGE=en

# The KB_LLM* and KB_LANGUAGE lines above are written into the a2kb config on the first
# start only; later changes are reported by kb-provision but not applied. To apply them
# (llm block and language only; storage, KBs, keys and data are kept, the old file is saved
# as config.yaml.bak), set this to 1, run `docker compose up -d`, then remove it again.
# KB_RECONFIGURE=1

# Timezone of the scheduled jobs
TZ=UTC

# ── Reaching the backend from other devices ─────────────────────────
# By default the S3 port (8333) and the MCP ports (8765-8774) listen on 127.0.0.1 of the
# Docker host only: fine for agents and Obsidian on the same machine. A phone or another
# computer needs HTTPS:
#
#   1. Point DNS records for s3.<DOMAIN> and mcp.<DOMAIN> at this host.
#   2. Set DOMAIN (and, optionally, ACME_EMAIL for certificate notices).
#   3. docker compose --profile https up -d       (Caddy gets the certificates itself;
#      ports 80 and 443 must be reachable)
#
# DOMAIN=kb.example.com
# ACME_EMAIL=you@example.com
# Or put `COMPOSE_PROFILES=https` here so a plain `docker compose up -d` includes Caddy.
#
# Without a domain, KB_BIND=0.0.0.0 publishes the ports on every network interface
# over unencrypted HTTP, so keys and content are sent in clear text. Use it only on a private
# network such as WireGuard or Tailscale. KB_PUBLIC_HOST is the name or address that clients
# should use; `a2kb connect` prints it.
# KB_BIND=127.0.0.1
# KB_PUBLIC_HOST=
# KB_S3_PORT=8333
# Behind your own reverse proxy instead of Caddy: the public addresses `a2kb connect` prints
# (S3 URL, and the base of the MCP URLs: <base>/<kb>/mcp).
# KB_PUBLIC_S3_URL=
# KB_PUBLIC_MCP_URL=

# ── Agents (MCP) ────────────────────────────────────────────────────
# KBs served over MCP, default: all of KB_NAMES. `none` turns the MCP server off.
# KB_MCP_KBS=research
# Opt-in tools; read-only search and read is the default. See docs/mcp.md before enabling.
# KB_MCP_ALLOW_WRITE=1                  # ingest_url (adds to raw/, never compiles)
# KB_MCP_INGEST_DOMAINS=example.com     # with ALLOW_WRITE: only these sites (recommended)
# KB_MCP_ALLOW_LLM=1                    # ask (spends LLM tokens)

# ── Scheduled jobs ──────────────────────────────────────────────────
# Weekly digest (Sundays) for every KB; costs a few thousand tokens per run
# KB_CRON_DIGEST=1

# ── Image build options (see Dockerfile) ────────────────────────────
# KB_EXTRAS=all          # pip extras; "all,whisper" adds local transcription
# INSTALL_CLIS=1         # 0 = leave out the claude and codex CLIs (API / Ollama setups)

# ── Storage ─────────────────────────────────────────────────────────
# [init] Where the containers reach S3 (default http://seaweedfs:8333, the bundled one). Only for
# SeaweedFS running elsewhere; it is stored in the a2kb config when a KB is created, so set it
# before the first `up`.
# KB_S3_INTERNAL_ENDPOINT=
# Default: the bundled SeaweedFS, with a separate key per KB for a2kb and for Obsidian,
# generated for you. Bucket name (3-63 chars; fixed once keys are issued; KB_S3_MODE is
# fixed after the first start as well):
# KB_BUCKET_NAME=kb-data
#
# To use your own S3 (R2, B2, AWS, MinIO, ...) instead, set the lines below and start with
#   COMPOSE_FILE=docker-compose.yml:docker-compose.external-s3.yml
# (put that line here too). See docs/docker.md#use-your-own-s3. The KB_EXT_S3_* connection
# values are [init]; all KBs share this one bucket and key (one bucket per KB on R2:
# docs/docker.md, "Several KBs on external storage").
# KB_S3_MODE=external
# KB_EXT_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # leave out for AWS
# KB_EXT_S3_REGION=auto
# KB_EXT_S3_BUCKET=
# KB_EXT_S3_ACCESS_KEY=
# KB_EXT_S3_SECRET_KEY=
# KB_EXT_S3_PRESET=r2          # aws, r2, b2, minio, wasabi or other (default: other / aws)
# KB_EXT_S3_CREATE_BUCKET=1    # create the bucket if it is missing
